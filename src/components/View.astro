---
import { copy } from '../data/editorial';
import {
  views,
  career,
  projects,
  type Locale,
  type ViewId,
} from '../data/content';
import HomeView from './views/HomeView.astro';
import AboutView from './views/AboutView.astro';
import CareerView from './views/CareerView.astro';
import SkillsView from './views/SkillsView.astro';
import ProjectsView from './views/ProjectsView.astro';
import CertificationsView from './views/CertificationsView.astro';
import AiView from './views/AiView.astro';
import ContactView from './views/ContactView.astro';
interface Props {
  lang: Locale;
  view: ViewId;
  detail?: string;
}
const { lang, view, detail } = Astro.props;

const page = views.find((v) => v.id === view)!;
const entry = career.find((c) => c.id === detail);
const project = projects.find((p) => p.id === detail);
const intro = {
  about: copy(
    'view-curiosity-is-where-i-start-good-software-is-where-i-m-headed',
    lang,
  ),
  career: copy('view-one-journey-many-perspectives', lang),
  skills: copy('view-the-right-tools-for-the-right-solution', lang),
  projects: copy('view-from-an-idea-to-software-that-works', lang),
  certifications: copy('view-learning-doesn-t-end-with-graduation', lang),
  ai: copy('view-develop-faster-decide-with-care', lang),
  contact: copy('view-good-collaboration-starts-with-a-conversation', lang),
  home: '',
};
---

{view === 'home' ? (
  <HomeView lang={lang} />
) : (
  <>
    <section class="page-heading">
      <a class="eyebrow" href={page.paths[lang]}>
        {page.title[lang]}
      </a>
      <h1 transition:name={project ? `project-${project.id}` : 'page-heading'}>
        {detail ? (entry?.company ?? project?.title[lang]) : intro[view]}
      </h1>
      <span class="tds-brandbar page-rule" aria-hidden="true"></span>
      {detail ? (
        <p>{entry?.summary[lang] ?? project?.summary[lang]}</p>
      ) : (
        <p>{page.description[lang]}</p>
      )}
    </section>
    {view === 'about' && <AboutView lang={lang} />}
    {view === 'career' && <CareerView lang={lang} detail={detail} />}
    {view === 'skills' && <SkillsView lang={lang} />}
    {view === 'projects' && <ProjectsView lang={lang} detail={detail} />}
    {view === 'certifications' && <CertificationsView lang={lang} />}
    {view === 'ai' && <AiView lang={lang} />}
    {view === 'contact' && <ContactView lang={lang} />}
  </>
)}
